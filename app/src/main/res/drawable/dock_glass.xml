<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass dock panel, tvOS 26 style. KitKat has no backdrop-blur API,
     so this is a translucent dark glass with a faint rim — reads as Liquid Glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC16161C" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
    <corners android:radius="28dp" />
</shape>
