<?xml version="1.0" encoding="utf-8"?>
<!-- Exact tvOS 26 tile: wide 5:3 card (248x148px measured from Apple's press shot), name below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- tvOS 26 app card: wide rounded rectangle, app artwork inside -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="132dp"
        android:background="@drawable/tile_background">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- Emoji icon slot (Settings gear tile) -->
        <TextView
            android:id="@+id/tileEmoji"
            android:layout_width="220dp"
            android:layout_height="132dp"
            android:gravity="center"
            android:textSize="52sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- App name under the card, tvOS style -->
    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="sans-serif-light"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

</LinearLayout>
