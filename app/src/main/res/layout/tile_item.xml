<?xml version="1.0" encoding="utf-8"?>
<!-- Exact tvOS tile: app artwork fills the whole rounded-square, name centered below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- tvOS app icon: full-bleed rounded-square (corners clipped in code) -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- Emoji icon slot (Settings gear tile): rounded glass background -->
        <TextView
            android:id="@+id/tileEmoji"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:gravity="center"
            android:background="@drawable/tile_background"
            android:textSize="64sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- App name under the icon, tvOS style -->
    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="sans-serif-light"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

</LinearLayout>
