<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Content layer: exact tvOS home — avatar left, greeting + clock right, grid below -->
    <LinearLayout
        android:id="@+id/contentLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/ambient_backdrop">

        <!-- tvOS header: avatar left — greeting + clock right, nothing else -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="56dp"
            android:paddingRight="56dp"
            android:paddingTop="36dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/avatarCircle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="@drawable/avatar_circle">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🙂"
                    android:textSize="22sp" />
            </FrameLayout>

            <!-- Greeting above the clock, tvOS-thin font -->
            <TextView
                android:id="@+id/homeGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-thin"
                android:textColor="#99FFFFFF"
                android:textSize="18sp" />

            <!-- Live clock under the greeting -->
            <TextView
                android:id="@+id/homeClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_below="@+id/homeGreeting"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />
        </RelativeLayout>

        <!-- Full-screen tvOS tile grid: full-bleed rounded-square icons, names below.
             scrollingCache/animationCache off: lighter RAM on 512MB boxes -->
        <GridView
            android:id="@+id/appGridView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:columnWidth="190dp"
            android:numColumns="auto_fit"
            android:horizontalSpacing="42dp"
            android:verticalSpacing="40dp"
            android:stretchMode="columnWidth"
            android:gravity="center"
            android:smoothScrollbar="true"
            android:scrollingCache="false"
            android:animationCache="false" />

        <!-- Footer credit -->
        <TextView
            android:id="@+id/footerCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            android:text="@string/made_in_pakistan"
            android:textColor="#55FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Control Center overlay (MENU key), tvOS style: features live here now -->
    <FrameLayout
        android:id="@+id/ccPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/ccDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_marginTop="64dp"
            android:layout_marginRight="48dp"
            android:orientation="vertical"
            android:background="@drawable/cc_backdrop"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="@string/cc_title"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Sleep Now -->
                <LinearLayout
                    android:id="@+id/ccSleep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/cc_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💤"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-light"
                        android:text="@string/cc_sleep"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Wi-Fi -->
                <LinearLayout
                    android:id="@+id/ccWifi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/cc_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📶"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/ccWifiState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-light"
                        android:text="@string/cc_wifi"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Bluetooth -->
                <LinearLayout
                    android:id="@+id/ccBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/cc_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔵"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/ccBluetoothState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-light"
                        android:text="@string/cc_bluetooth"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Search/Apps row -->
            <LinearLayout
                android:id="@+id/ccSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/cc_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/cc_search"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Home Screen Apps row -->
            <LinearLayout
                android:id="@+id/ccHomeApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/cc_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/customize_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Input row -->
            <LinearLayout
                android:id="@+id/ccInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/cc_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/btn_input"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Standby overlay: dim layer -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone" />

    <!-- Standby overlay: Aerial-style screensaver (sky gradient + giant clock) -->
    <LinearLayout
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/aerial_backdrop"
        android:visibility="gone">

        <TextView
            android:id="@+id/screensaverClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:textColor="#FFFFFF"
            android:textSize="80sp"
            android:shadowRadius="16"
            android:shadowColor="#66000000"
            android:shadowDy="0" />

        <TextView
            android:id="@+id/screensaverDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:textColor="#CCFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/made_in_pakistan"
            android:textColor="#55FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
