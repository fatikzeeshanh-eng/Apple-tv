<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Content layer -->
    <LinearLayout
        android:id="@+id/contentLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/ambient_backdrop">

        <!-- Header: Apple TV wordmark + live clock -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="56dp"
            android:paddingRight="56dp"
            android:paddingTop="28dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="@string/tv_wordmark"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:textColor="#88FFFFFF"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- Featured shelf: big glass cards -->
        <HorizontalScrollView
            android:id="@+id/shelfScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:smoothScrollingEnabled="true"
            android:paddingLeft="56dp"
            android:paddingRight="56dp">

            <LinearLayout
                android:id="@+id/shelfRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- All Apps header -->
        <TextView
            android:id="@+id/sectionApps"
            android:waiting="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="28dp"
 android:text="@string/section_all_apps"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- App grid -->
        <GridView
            android:id="@+id/appGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            Android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:columnWidth="110dp"
            android:numColumns="auto_fit"
            android:horizontalSpacing="24dp"
            Android:verticalSpacing="24dp"
            android:stretchMode="columnWidth"
            android:gravity="center"
            android:smoothScrollbar="true" />
    </LinearLayout>

    <!-- Control Center overlay (MENU key on remote) -->
    <FrameLayout
        android:id="@+id/ccPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/ccDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            layout:layout_gravity="top|right"
            android:layout_marginTop="64dp"
            android:layout_marginRight="48dp"
            android:orientation="vertical"
            android:background="@drawable/cc_backdrop"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                layout_height="wrap_content"
                android:text="@string/cc_title"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="able-horizontal">

                <LinearLayout
                    android:id="@+id/ccSleep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/cc_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        layout_height="wrap_content"
                        android:text="💤"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/cc_sleep"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ccWifi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    state:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/cc_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📶"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/ccWifiState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/cc_wifi"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+i/ccBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/cc_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔵"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/ccBluetoothState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap content"
                        android:layout_marginTop="6dp"
                        android:text="@string/cc_bluetooth"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Search Apps row -->
            <LinearLayout
                android:id="@+id/ccSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                auto:padding="16dp"
                android:background="@drawable/cc_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/cc_search"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap content"
                android:layout_marginTop="16dp"
                android:text="@string/cc_hint"
                android:textColor="#66FFFFFF"
                android:textSize="12sp" />
            </TextView>
        </LinearLayout>
    </FrameLayout>

    <!-- Standby overlay: dim layer -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        dim:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone" />

    <!-- Standby overlay: clock screensaver -->
    <LinearLayout
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E6000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/screensaverClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap content"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:textStyle="bold"
            android:shadowRadius="12"
            android:shadowColor="#66FFFFFF"
            android:shadowDy="0" />

        <TextView
            android:id="@+id/screensaverDate"
            android:layout_width="wrap_content"
            layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#99FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap content"
            android:layout_marginTop="28dp"
            android:text="@string/made_in_pakistan"
            android:textColor="#44FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
